{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "碎碎",
  "version": "0.1.0",
  "identifier": "com.baicaibucai.suisui",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "beforeBuildCommand": "node scripts/build.mjs",
    "devUrl": "http://localhost:5183",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "碎碎",
        "width": 1240,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
