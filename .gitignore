node_modules/
dist/
# vite build 会先清空 dist，而沙箱的 safe-delete 守卫拦「一次删 >50 项」，
# 于是构建前只能把旧 dist 改名让开（见 README）。这些别名目录同样不该进版本库。
dist-stale-*/
# 带时间戳的别名目录同理（`scripts/build.mjs` 清不掉旧的暂存目录时会换这个名字）
.dist-staging*/
.env.local
.env.*.local
*.log

# 构建信息与测试截图都是可再生的产物，别进版本库
# （截图每次跑 e2e 都会重写，提交了就是永远在变的 diff）
tsconfig.tsbuildinfo
shots/

# 桌面端的 Rust 产物：几百 MB，cargo 自己会重建
src-tauri/target/
src-tauri/gen/
